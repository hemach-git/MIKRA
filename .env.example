# Copy to .env (gitignored). Never commit real keys. Keep comments on their own lines.

# mock   = offline, rule-based pipeline (no AI calls)
# openai = multi-agent mode using OPENAI_API_KEY
LLM_PROVIDER=mock

# Needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here

# Optional: model for all agents (default is set in config.yaml)
# OPENAI_MODEL=gpt-4o-mini
